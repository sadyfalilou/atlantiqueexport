##############################################################################
# Atlantique Export — variables d'environnement
#
# Copiez ce fichier en `.env.local` et remplissez les valeurs réelles.
# `.env.local` est ignoré par Git : aucune clé secrète ne doit être versionnée.
#
# Règle de sécurité : seules les variables préfixées NEXT_PUBLIC_ sont exposées
# au navigateur. Tout le reste reste côté serveur. Si vous hésitez, ne mettez
# pas le préfixe.
##############################################################################

# --- Site --------------------------------------------------------------------
# URL publique du site, utilisée pour les liens absolus, le sitemap et les
# métadonnées Open Graph. En développement : http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://atlantiqueexport.com

# --- Supabase ----------------------------------------------------------------
# Tableau de bord Supabase → Settings → API Keys
#
# Supabase a renommé ses clés. Nous utilisons les NOUVELLES (onglet « API
# Keys »), pas les anciennes `anon` / `service_role` de l'onglet « Legacy API
# Keys », qui sont annoncées comme abandonnées d'ici la fin de 2026.

NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co

# Clé publique, exposée au navigateur. C'est normal et sans danger : elle ne
# donne accès qu'à ce que les politiques RLS autorisent. Commence par
# « sb_publishable_ ».
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_

# ⚠️ Clé secrète : elle porte l'attribut BYPASSRLS et contourne donc TOUTES les
# politiques de sécurité de la base. Ne jamais la préfixer NEXT_PUBLIC_, ne
# jamais l'importer dans un composant client. Commence par « sb_secret_ ».
SUPABASE_SECRET_KEY=sb_secret_

# Connexion PostgreSQL, pour les migrations et les seeds.
# Tableau de bord → bouton « Connect » → onglet « Session pooler ».
#
# ⚠️ Prenez « Session pooler », pas « Direct connection ». L'hôte de la
# connexion directe (db.xxx.supabase.co) n'a qu'un enregistrement DNS IPv6 :
# sur un réseau IPv4 — le cas de la plupart des fournisseurs canadiens — il
# est tout simplement injoignable. Le pooler, lui, répond en IPv4.
#
# La chaîne du pooler diffère de la connexion directe : l'utilisateur est
# « postgres.<identifiant-projet> » et l'hôte « aws-N-<region>.pooler.supabase.com ».
# Copiez-la telle quelle depuis le tableau de bord, ne la reconstruisez pas.
#
# Si le mot de passe contient des caractères spéciaux (@ : / ? # & %), ils
# doivent être encodés en pourcentage, sinon l'URL est mal découpée.
SUPABASE_DB_URL=postgresql://postgres.votreprojet:motdepasse@aws-0-ca-central-1.pooler.supabase.com:5432/postgres

# --- Stripe (PHASE 2 — inutile au lancement) ---------------------------------
# Le paiement par carte est reporté : le MVP fonctionne au virement Interac et
# au paiement au ramassage. Laissez ces lignes commentées jusque-là.
#
# Tableau de bord Stripe → Développeurs → Clés API. Utilisez les clés de test
# (pk_test_/sk_test_) tant que vous n'êtes pas en production.
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
# STRIPE_SECRET_KEY=sk_test_
#
# Secret de signature du webhook, obtenu avec :
#   stripe listen --forward-to localhost:3000/api/webhooks/stripe
# Sans lui les webhooks sont rejetés — c'est voulu : une commande n'est
# confirmée que par un webhook dont la signature est vérifiée.
# STRIPE_WEBHOOK_SECRET=whsec_

# --- Resend (courriels transactionnels) --------------------------------------
RESEND_API_KEY=re_
# L'adresse d'expédition doit appartenir à un domaine vérifié dans Resend.
RESEND_FROM_EMAIL="Atlantique Export <commandes@atlantiqueexport.com>"
RESEND_REPLY_TO_EMAIL=info@atlantiqueexport.com

# --- Virement Interac --------------------------------------------------------
# ⚠️ LAISSER VIDE tant que l'adresse réelle n'est pas connue.
# Cette valeur s'affiche telle quelle au client comme destination de son
# virement : une adresse d'exemple enverrait de l'argent dans le vide. Tant
# qu'elle est vide, la page de confirmation affiche « adresse à confirmer ».
INTERAC_RECIPIENT_EMAIL=
# Réponse à la question de sécurité, si le dépôt automatique n'est pas activé.
INTERAC_SECURITY_ANSWER=

# --- Administration ----------------------------------------------------------
# Courriel du premier super administrateur, créé par le script de seed.
ADMIN_BOOTSTRAP_EMAIL=

# --- Divers ------------------------------------------------------------------
# Fuseau utilisé pour les créneaux de livraison et les rapports.
TZ=America/Montreal
